{
    "name": "crell/planedo-bundle",
    "description": "Feed aggregator bundle for Symfony 8 and later.",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Larry Garfield",
            "email": "larry@garfieldtech.com",
            "homepage": "https://www.garfieldtech.com",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.3",
        "easycorp/easyadmin-bundle": "^5.0",
        "laminas/laminas-feed": "^2.23",
        "nyholm/psr7": "^1.8",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/password-hasher": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/yaml": "^8.0",
        "symfonycasts/reset-password-bundle": "^1.24",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "overtrue/phplint": "^9.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/phpunit-bridge": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Crell\\Bundle\\Planedo\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crell\\Bundle\\Planedo\\Tests\\TestApplication\\": "tests/TestApplication/src/",
            "Crell\\Bundle\\Planedo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:php:unit": [
            "phpunit -c phpunit.xml.dist"
        ],
        "test:php:lint": [
            "phplint"
        ],
        "test:php:stan": [
            "phpstan analyse"
        ],
        "test": [
            "@test:php:lint",
            "@test:php:unit"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    }
}
